{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git pull origin main)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin main)",
      "Bash(git check-ignore:*)",
      "Bash(git ls-files:*)",
      "Bash(gh api repos/parkggotyiseul/woonhyangjae:*)",
      "Bash(gh auth status)",
      "Bash(gh repo view:*)",
      "Bash(curl -s -o /dev/null -w:*)",
      "Bash(curl -sI https://woonhyangjae.com:*)",
      "Bash(ssh -i woonhyangjae.pem:*)",
      "Bash(ssh -i ~/woonhyangjae/woonhyangjae.pem:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Read(./woonhyangjae.pem)",
      "Read(./*.key)",
      "Read(./.env)"
    ]
  }
}
